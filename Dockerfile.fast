# Fast Dockerfile - Skips heavy dependencies that aren't needed
# Use this if vector cache is permanently disabled

FROM node:20-slim AS base

# Install system dependencies (minimal for faster build)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Create a minimal package.json without heavy dependencies
# Remove @xenova/transformers and @qdrant/js-client-rest since vector cache is disabled
RUN node -e "\
const fs = require('fs'); \
const pkg = JSON.parse(fs.readFileSync('package.json')); \
delete pkg.dependencies['@xenova/transformers']; \
delete pkg.dependencies['@qdrant/js-client-rest']; \
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2)); \
console.log('Removed heavy dependencies:', ['@xenova/transformers', '@qdrant/js-client-rest'].join(', ')); \
"

# Configure npm for faster installs
RUN npm config set fetch-retries 2 && \
    npm config set fetch-timeout 60000 && \
    npm config set progress false && \
    npm config set loglevel warn

# Install dependencies (much faster without transformers and qdrant)
RUN echo "Installing dependencies (should be much faster now)..." && \
    npm install --production --no-audit --no-fund --legacy-peer-deps && \
    npm cache clean --force

# Copy application code
COPY . .

# Create temp directories
RUN mkdir -p temp/videos temp/frames temp/audio

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV TEMP_VIDEO_DIR=./temp/videos/
ENV TEMP_FRAMES_DIR=./temp/frames/
ENV TEMP_AUDIO_DIR=./temp/audio/

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Run the application
CMD ["node", "server.js"]

